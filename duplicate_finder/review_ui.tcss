/* duplicate_finder/review_ui.tcss */
Screen {
    background: blue;
    color: white;
}

Header {
    background: white;
    color: blue;
}

Footer {
    background: white;
    color: blue;
}

/* Footer renders key hints via FooterKey, whose text is styled through the
   footer-key--key/footer-key--description component classes rather than
   Footer's own background/color -- without these, the built-in theme's
   tokens win and produce low-contrast text regardless of the rule above. */
FooterKey {
    background: white;
}

FooterKey .footer-key--key {
    background: white;
    color: blue;
    text-style: bold;
}

FooterKey .footer-key--description {
    background: white;
    color: blue;
}

FooterKey:hover {
    background: yellow;
}

FooterLabel {
    background: white;
    color: blue;
}

Tree {
    background: blue;
    color: white;
}

Tree > .tree--cursor {
    background: white;
    color: blue;
}

/* Without this, the blanket Screen{} rule above (Screen is ModalScreen's
   base class) overrides ModalScreen's own dimmed, translucent default
   background, and with no `align` set the dialog box renders pinned to the
   top-left -- together that makes every dialog look like a fullscreen page
   swap instead of a small floating modal over the dimmed tree view. */
SettingsScreen, CommitConfirmScreen, KeywordFilterScreen {
    background: $background 60%;
    align: center middle;
}

#settings-dialog, #commit-dialog, #keyword-dialog {
    background: blue;
    color: white;
    border: solid white;
    padding: 1 2;
    width: 64;
    height: auto;
}

/* Horizontal/Vertical default to height: 1fr, so a button row placed in one
   of these auto-height dialogs would otherwise stretch to fill all
   remaining screen space instead of hugging the buttons' own height. */
.dialog-buttons {
    height: auto;
    width: auto;
}

/* Settings has more fields than a terminal is guaranteed to be tall enough
   to show at once, so it scrolls internally within the viewport rather than
   growing past it -- Apply/Cancel must always stay reachable. */
#settings-dialog {
    max-height: 100%;
}

Button {
    background: white;
    color: blue;
    border: solid blue;
}

Button:focus {
    background: yellow;
    color: blue;
}

Input, Select, Switch {
    background: white;
    color: blue;
}
